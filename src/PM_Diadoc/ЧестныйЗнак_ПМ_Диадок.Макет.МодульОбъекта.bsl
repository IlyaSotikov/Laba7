// ЧЗ: ПМ Диадок — обработчики событий подключаемого модуля Контур.Диадок (этапы 1–3, 5).
// Подключается как внешний ПМ к объекту Обработки.КонтурЭДО (константа ДиадокПодключаемыйМодульТип ≠ «Нет»).
// События ПМ фиксированы типовым модулем: ПослеАнализаПакета, ПослеОбработкиЛентыСобытий,
// ПослеЗаполненияКонтента, ПослеУстановкиСтатусаДокумента.

// ============ КАНДИДАТЫ ИМЕН СВОЙСТВ ПРОТОКОНТЕНТА С КМ (подтвердить дампом ЧЗ.ПМ.Диагностика.Контент, п.11) ============
Функция ИменаСвойствКМВПротоконтенте()
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("MarkedCodes");
	МассивИмен.Добавить("MarkingCodes");
	МассивИмен.Добавить("Codes");
	МассивИмен.Добавить("KM");
	МассивИмен.Добавить("KMDT");
	МассивИмен.Добавить("ProductCodes");
	МассивИмен.Добавить("CodeMarking"); // Candidate from XML-дампы ON_NSCHFDOPPOK…
	Возврат МассивИмен;
КонецФункции

// Извлечь список КМ из протоконтента УПД по кандидатам имён свойств.
Функция ИзвлечьКМИзПротоконтента(ПротоКонтент) Экспорт
	Коды = Новый Массив;
	Если ПротоКонтент = Неопределено Тогда
		Возврат Коды;
	КонецЕсли;
	Для Каждого ИмяСвойства Из ИменаСвойствКМВПротоконтенте() Цикл
		Попытка
			ЗначениеСвойства = ПротоКонтент[ИмяСвойства];
			Если ЗначениеСвойства = Неопределено Тогда Продолжить; КонецЕсли;
			// свойство может быть массивом структур или строкой с разделителями
			ТипЗначения = ТипЗнч(ЗначениеСвойства);
			Если ТипЗначения = Тип("Массив") Тогда
				Для Каждого Элемент Из ЗначениеСвойства Цикл
					Код = ПредставлениеКодаМаркировки(Элемент);
					Если НЕ ПустаяСтрока(Код) Тогда Коды.Добавить(Код); КонецЕсли;
				КонецЦикла;
			Иначе
				Код = ПредставлениеКодаМаркировки(ЗначениеСвойства);
				Если НЕ ПустаяСтрока(Код) Тогда Коды.Добавить(Код); КонецЕсли;
			КонецЕсли;
		Исключение
			// свойства с таким именем нет — следующий кандидат
		КонецПопытки;
	КонецЦикла;
	Возврат Коды;
КонецФункции

Функция ПредставлениеКодаМаркировки(Элемент)
	Если ТипЗнч(Элемент) = Тип("Строка") Тогда
		Возврат СокрЛП(Элемент);
	КонецЕсли;
	// структура/соответствие: ищем поле кода по кандидатам
	Ключи = СтрРазделить("Код,Code,Gtin,KM,Value", ",", Ложь);
	Для Каждого Ключ Из Ключи Цикл
		Попытка
			Если ЗначениеЗаполнено(Элемент[Ключ]) Тогда
				Возврат СокрЛП(Строка(Элемент[Ключ]));
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЦикла;
	Возврат "";
КонецФункции

// ============ СОБЫТИЕ 1: ПослеАнализаПакета — входящий УПД: извлечение КМ в РС ЧЗ_МаркиИзЭДО (требование 1) ============
Процедура ПослеАнализаПакета(Пакет, РезультатАнализа) Экспорт
	Попытка
		Для Каждого Document Из РезультатАнализа.НовыеДокументы Цикл
			ОбработатьВходящийDocument(Document);
		КонецЦикла;
	Исключение
		ЧЗ_Журнал.Записать("ПослеАнализаПакета", Неопределено, "", "", "Ошибка", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ОбработатьВходящийDocument(Document)
	BoxID = Document.BoxId;
	DocumentId = Document.DocumentId;
	Направление = ?(Document.IsInbound, "Inbound", "Outbound");

	ПротоКонтент = Неопределено;
	Попытка
		ПротоКонтент = ПротоКонтентДокумента(Document);
	Исключение
		// diagnostic dump: см. ЧЗ.ПМ.Диагностика.Контент
	КонецПопытки;

	Коды = ИзвлечьКМИзПротоконтента(ПротоКонтент);
	Если Коды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Код Из Коды Цикл
		МЗ = РегистрыСведений.ЧЗ_МаркиИзЭДО.СоздатьМенеджерЗаписи();
		МЗ.КодМаркировки = Код;
		МЗ.ДиадокDocumentId = DocumentId;
		МЗ.ДатаИзвлечения = ТекущаяДата();
		МЗ.Статус = "Извлечен";
		МЗ.Записать();
		// сразу регистрируем марку в обороте (если ещё не списана ранее)
		МО = РегистрыСведений.ЧЗ_ОборотМарок.СоздатьМенеджерЗаписи();
		МО.КодМаркировки = Код;
		МО.Прочитать();
		Если МО.Статус <> "Списан" Тогда
			МО.Статус = "ВОбороте";
			МО.ДатаОперации = ТекущаяДата();
			МО.Записать();
		КонецЕсли;
	КонецЦикла;

	ЗаписатьСвязьДокумента(Неопределено, DocumentId, Направление, "");
	ЧЗ_Журнал.Записать("ИзвлечениеКМ", Неопределено, DocumentId, "", "Успех",
		"Извлечено марок: " + Коды.Количество() + ", направление: " + Направление);
КонецПроцедуры

// ============ СОБЫТИЕ 2: ПослеОбработкиЛентыСобытий — догон извлечений и статусов (требование 1,2) ============
Процедура ПослеОбработкиЛентыСобытий(ЛентаСобытий) Экспорт
	Попытка
		// лента может содержать события по уже загруженным пакетам — фиксируем в журнале
		ЧЗ_Журнал.Записать("ПослеОбработкиЛентыСобытий", Неопределено, "", "", "Успех",
			"Обработано событий ленты: " + ?(ЛентаСобытий <> Неопределено, ЛентаСобытий.Количество(), 0));
	Исключение
		ЧЗ_Журнал.Записать("ПослеОбработкиЛентыСобытий", Неопределено, "", "", "Предупреждение", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// ============ СОБЫТИЕ 3: ПослеУстановкиСтатусаДокумента ============
// Inbound + «Подписан» → событие журнала, кнопка загрузки становится доступной (требование 2).
// Outbound + подпись клиента → списание КМ ENTERPRISE_USE + ИНН (требования 5, 6).
Процедура ПослеУстановкиСтатусаДокумента(Document, НовыйСтатус) Экспорт
	Попытка
		DocumentId = Document.DocumentId;
		Направление = ?(Document.IsInbound, "Inbound", "Outbound");

		// найти связь с документом 1С
		Док1С = НайтиДокумент1СПоСвязи(DocumentId);

		ОбновитьСтатусСвязи(Док1С, DocumentId, Направление, НовыйСтатус);

		Если Направление = "Inbound" И СтатусПодписан(НовыйСтатус) Тогда
			ЧЗ_Журнал.Записать("ПодписаниеВходящего", Док1С, DocumentId, "", "Успех",
				"Входящий УПД подписан: " + НовыйСтатус + ". Кнопка «ЧЗ: загрузить марки в поступление» доступна.");
		КонецЕсли;

		Если Направление = "Outbound" И СтатусПодписанКонтрагентом(НовыйСтатус) Тогда
			Если Док1С <> Неопределено Тогда
				ЧЗ_ОборотСервер.СписатьМаркиПоДокументу(Док1С, DocumentId);
			Иначе
				ЧЗ_Журнал.Записать("Списание", Неопределено, DocumentId, "", "Предупреждение",
					"Исходящий подписан, но связь с документом 1С не найдена — догонит РЗ ЧЗ_КонтрольСтатусовЭДО");
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЧЗ_Журнал.Записать("ПослеУстановкиСтатусаДокумента", Неопределено, "", "", "Ошибка", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция СтатусПодписан(Статус)
	Список = СтрРазделить("Подписан,ПодписанМной,ДокументооборотЗавершен", ",", Ложь);
	Возврат Список.Найти(Статус) <> Неопределено;
КонецФункции

Функция СтатусПодписанКонтрагентом(Статус)
	Список = СтрРазделить("ПодписанКонтрагентом,ДокументооборотЗавершен,ПодписанПолучателем", ",", Ложь);
	Возврат Список.Найти(Статус) <> Неопределено;
КонецФункции

// ============ СОБЫТИЕ 4: ПослеЗаполненияКонтента — исходящий УПД: КМ в контент (требование 5) ============
Процедура ПослеЗаполненияКонтента(Document, Контент, ПараметрыПМ) Экспорт
	Попытка
		Если ПараметрыПМ <> Неопределено И ПараметрыПМ.DocumentType = "UniversalTransferDocument" Тогда
			Док1С = НайтиДокумент1СПоСвязи(Document.DocumentId);
			Коды = МассивКМДокумента(Док1С);
			Если Коды.Количество() > 0 Тогда
				ВнедритьКМВКонтент(Контент, Коды);
				ЧЗ_Журнал.Записать("ЗаполнениеКонтента", Док1С, Document.DocumentId, "", "Успех",
					"КМ добавлены в контент УПД: " + Коды.Количество());
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЧЗ_Журнал.Записать("ЗаполнениеКонтента", Неопределено, "", "", "Ошибка", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция МассивКМДокумента(Док1С)
	Коды = Новый Массив;
	Если Док1С = Неопределено Тогда Возврат Коды; КонецЕсли;
	Попытка
		Для Каждого СтрокаТЧ Из Док1С.КодыМаркировки Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.КодМаркировки) Тогда
				Коды.Добавить(СтрокаТЧ.КодМаркировки);
			КонецЕсли;
		КонецЦикла;
	Исключение КонецПопытки;
	Возврат Коды;
КонецФункции

// Внедрение КМ в контент УПД: имена полей подтверждаются дампом диагностики (п.11).
// Кандидаты: content.MarkedCodes / СтруктураКонтента / ДопСведения.
Процедура ВнедритьКМВКонтент(Контент, Коды)
	Попытка
		Контент.MarkedList = Коды;
		Возврат;
	Исключение КонецПопытки;
	Попытка
		Контент.MarkedCodes = Коды;
		Возврат;
	Исключение КонецПопытки;
	Попытка
		// последний вариант — через доп. сведения (КонвертироватьДопСвойста = Истина учитывать для жёсткого списка BoxID!)
		Контент.ДопСведения = ?(ЗначениеЗаполнено(Контент.ДопСведения), Контент.ДопСведения + "; ", "")
			+ "КМ=" + СтрСоединить(Коды, ",");
	Исключение
		ЧЗ_Журнал.Записать("ЗаполнениеКонтента", Неопределено, "", "", "Предупреждение",
			"Не удалось внедрить КМ ни в одно известное поле контента");
	КонецПопытки;
КонецПроцедуры

// ============ Служебные: связи документов ============
Процедура ЗаписатьСвязьДокумента(Док1С, DocumentId, Направление, Статус)
	МЗ = РегистрыСведений.ЧЗ_СвязиДокументовЭДО.СоздатьМенеджерЗаписи();
	МЗ.Документ1С = Док1С;
	МЗ.ДиадокDocumentId = DocumentId;
	МЗ.Направление = Направление;
	МЗ.СтатусПоследний = Статус;
	МЗ.Записать();
КонецПроцедуры

Процедура ОбновитьСтатусСвязи(Док1С, DocumentId, Направление, Статус)
	Если Док1С = Неопределено Тогда Возврат; КонецЕсли;
	МЗ = РегистрыСведений.ЧЗ_СвязиДокументовЭДО.СоздатьМенеджерЗаписи();
	МЗ.Документ1С = Док1С;
	МЗ.ДиадокDocumentId = DocumentId;
	МЗ.Направление = Направление;
	МЗ.СтатусПоследний = Статус;
	МЗ.Записать();
КонецПроцедуры

Функция НайтиДокумент1СПоСвязи(DocumentId)
	Если ПустаяСтрока(DocumentId) Тогда Возврат Неопределено; КонецЕсли;
	Отбор = Новый Структура("ДиадокDocumentId", DocumentId);
	Выборка = РегистрыСведений.ЧЗ_СвязиДокументовЭДО.Выбрать(Отбор);
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Документ1С) Тогда
			Возврат Выборка.Документ1С;
		КонецЕсли;
	КонецЦикла;
	// fallback: по регистру марок — поступление, связанное с DocumentId
	Отбор2 = Новый Структура("ДиадокDocumentId", DocumentId);
	Выборка2 = РегистрыСведений.ЧЗ_МаркиИзЭДО.Выбрать(Отбор2);
	Пока Выборка2.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка2.ДокументПоступление) Тогда
			Возврат Выборка2.ДокументПоступление;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
