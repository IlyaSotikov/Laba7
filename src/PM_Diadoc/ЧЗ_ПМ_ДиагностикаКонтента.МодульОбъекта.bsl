// ЧЗ: диагностика контента ПМ Диадок — дамп имён свойств протоконтента для подтверждения
// кандидатов из функции ИменаСвойствКМВПротоконтенте (открытый вопрос п.11).
// Вызывается из формы epf ПМ: кнопка «ЧЗ.ПМ.Диагностика.Контент».

Функция ДампСвойствПротоконтента(ПротоКонтент) Экспорт
	СтрокаДампа = "";
	Если ПротоКонтент = Неопределено Тогда
		Возврат "Протоконтент = Неопределено";
	КонецЕсли;
	ТипОписания = ОписаниеТипаЧерезОтражение(ПротоКонтент);
	Возврат ТипОписания;
КонецФункции

// Универсальный рефлексивный дамп: для COM/Диадок-объектов — через Свойства(),
// для 1С Структура/Соответствие — через известные механизмы коллекций.
Функция ОписаниеТипаЧерезОтражение(Объект)
	Список = Новый Массив;
	Попытка
		// Соответствие / коллекция Диадок
		Для Каждого Пары Из Объект Цикл
			Список.Добавить(Строка(Пары.Ключ) + ":" + ТипЗнч(Пары.Значение));
		КонецЦикла;
	Исключение
		// не коллекция — перебор имён-кандидатов
		Кандидаты = СтрРазделить("MarkedCodes,MarkingCodes,Codes,KM,KMDT,ProductCodes,CodeMarking,Date,Number,Totals,Signer,Creator,CreatorBase", ",", Ложь);
		Для Каждого ИмяИзвестного Из Кандидаты Цикл
			Попытка
				Зн = Объект[ИмяИзвестного];
				Если Зн <> Неопределено Тогда
					Список.Добавить(ИмяИзвестного + ":" + ТипЗнч(Зн));
				КонецЕсли;
			Исключение КонецПопытки;
		КонецЦикла;
	КонецПопытки;
	Возврат СтрСоединить(Список, "; ");
КонецФункции
