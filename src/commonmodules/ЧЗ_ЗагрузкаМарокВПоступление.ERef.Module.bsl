// ЧЗ: загрузка КМ из регистрa ЧЗ_МаркиИзЭДО в ТЧ КодыМаркировки выбранного поступления (требование 1).
// Вызывается с формы списка входящих документов кнопкой «ЧЗ: загрузить марки в поступление».

Функция МаркиДляДокументаПоступления(ДиадокDocumentId) Экспорт
	// вернуть массив кодов из РС ЧЗ_МаркиИзЭДО по DocumentId, статус Извлечен
	Отбор = Новый Структура("ДиадокDocumentId", ДиадокDocumentId);
	Запись = РегистрыСведений.ЧЗ_МаркиИзЭДО.Выбрать(Отбор);
	Коды = Новый Массив;
	Пока Запись.Следующий() Цикл
		Если Запись.Статус = "Извлечен" Тогда
			Коды.Добавить(Запись.КодМаркировки);
		КонецЕсли;
	КонецЦикла;
	Возврат Коды;
КонецФункции

Процедура ЗагрузитьМаркиВПоступление(ПоступлениеСсылка, ДиадокDocumentId) Экспорт
	Коды = МаркиДляДокументаПоступления(ДиадокDocumentId);
	Если Коды.Количество() = 0 Тогда
		ЧЗ_Журнал.Записать("ЗагрузкаВПоступление", ПоступлениеСсылка, ДиадокDocumentId, "",
			"Предупреждение", "Нет марок со статусом Извлечен для загрузки");
		Возврат;
	КонецЕсли;

	Объект = ПоступлениеСсылка.ПолучитьОбъект();
	ТЧ = Объект.КодыМаркировки; // или Материалы/Товары — см. п.11 открытые вопросы
	Для Каждого Код Из Коды Цикл
		НоваяСтрока = ТЧ.Добавить();
		НоваяСтрока.КодМаркировки = Код;
	КонецЦикла;
	Объект.Записать(РежимЗаписиДокумента.Проведение);

	// помечаем марки как загруженные
	Менеджер = РегистрыСведений.ЧЗ_МаркиИзЭДО.СоздатьМенеджерЗаписи();
	Для Каждого Код Из Коды Цикл
		Менеджер.КодМаркировки = Код;
		Менеджер.ДиадокDocumentId = ДиадокDocumentId;
		Менеджер.Прочитать();
		Менеджер.Статус = "Загружен";
		Менеджер.ДатаЗагрузки = ТекущаяДата();
		Менеджер.ДокументПоступление = ПоступлениеСсылка;
		Менеджер.Записать();
	КонецЦикла;

	ЧЗ_Журнал.Записать("ЗагрузкаВПоступление", ПоступлениеСсылка, ДиадокDocumentId, "",
		"Успех", "Загружено марок: " + Коды.Количество());
КонецПроцедуры
