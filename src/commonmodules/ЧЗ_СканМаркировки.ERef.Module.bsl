// ЧЗ: окно сканирования маркировки (требование 4). Авто-открытие при добавлении маркированной строки,
// повторное открытие кнопкой «ЧЗ: сканировать марки», проверка каждого кода через ЧЗ_ПроверкаКМ.
// Точка встройки в штатные формы: ФормаСканированияМаркировки / СканированиеКодаМаркировки (факт п.6).

// Серверная часть: добавить код в ТЧ документа после проверки. Возвращает Структура(Результат, Комментарий).
Функция ДобавитьКодВПТЧДокумента(ДокСсылка, Код) Экспорт
	Проверка = ЧЗ_ПроверкаКМ.ПроверитьКод(Код, ДокСсылка);
	Если Проверка.Результат = "ОК" Тогда
		Объект = ДокСсылка.ПолучитьОбъект();
		НайденСуществующий = Ложь;
		Попытка
			Для Каждого СтрокаТЧ Из Объект.КодыМаркировки Цикл
				Если СтрокаТЧ.КодМаркировки = Код Тогда
					НайденСуществующий = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение КонецПопытки;
		Если НЕ НайденСуществующий Тогда
			НоваяСтрока = Объект.КодыМаркировки.Добавить();
			НоваяСтрока.КодМаркировки = Код;
			Объект.Записать();
		КонецЕсли;
		// фиксируем марку как находящуюся в обороте
		МЗ = РегистрыСведений.ЧЗ_ОборотМарок.СоздатьМенеджерЗаписи();
		МЗ.КодМаркировки = Код;
		МЗ.Прочитать();
		Если МЗ.Статус <> "Списан" Тогда
			МЗ.Статус = "ВОбороте";
			МЗ.ДатаОперации = ТекущаяДата();
			МЗ.Записать();
		КонецЕсли;
	КонецЕсли;
	ЧЗ_Журнал.Записать("Сканирование", ДокСсылка, "", Код, Проверка.Результат, Проверка.Комментарий);
	Возврат Проверка;
КонецФункции
