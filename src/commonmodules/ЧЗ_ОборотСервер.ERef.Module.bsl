// ЧЗ: ядро оборота кодов маркировки (шины) — списание по подписи клиента через Диадок.
// Требования 5, 6. Причина вывода из оборота: ENTERPRISE_USE («собственные нужды покупателя»), ИНН покупателя.

ПеречислениеПричиныВывода = "ПричиныВыводаИзОборота"; // защитное имя перечисления (см. п.11 открытых вопросов)

// Основная процедура: списать все КМ документа-основания (ЗаказНаряд/Реализация) по исходящему УПД.
Процедура СписатьМаркиПоДокументу(Док1С, ДиадокDocumentId) Экспорт
	ТЧ = Неопределено;
	Попытка
		ТЧ = Док1С.КодыМаркировки;
	Исключение
		ТЧ = Неопределено;
	КонецПопытки;

	Если ТЧ = Неопределено Или ТЧ.Количество() = 0 Тогда
		ЧЗ_Журнал.Записать("Списание", Док1С, ДиадокDocumentId, "",
			"Предупреждение", "В документе нет марок — списание не требуется");
		Возврат;
	КонецЕсли;

	ИННПокупателя = "";
	Контрагент = ЧЗ_КонтрагентДокумента(Док1С);
	Попытка
		ИННПокупателя = Контрагент.ИНН;
	Исключение
		ИННПокупателя = "";
	КонецПопытки;

	КодПричины = КодПричиныВыводаДляСобственныхНужд();

	Списано = 0;
	Пропущено = 0;
	Для Каждого Строка Из ТЧ Цикл
		Код = Строка.КодМаркировки;
		Если НЕ ЗначениеЗаполнено(Код) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		МЗ = РегистрыСведений.ЧЗ_ОборотМарок.СоздатьМенеджерЗаписи();
		МЗ.КодМаркировки = Код;
		МЗ.Прочитать();
		Если МЗ.Статус = "Списан" Тогда
			Пропущено = Пропущено + 1;
			Продолжить; // защита от повторного списания
		КонецЕсли;

		МЗ.Статус = "Списан";
		МЗ.ДокументСписания = Док1С;
		МЗ.ПричинаСписания = КодПричины;
		МЗ.ИННПокупателя = ИННПокупателя;
		МЗ.ДиадокDocumentId = ДиадокDocumentId;
		МЗ.ДатаОперации = ТекущаяДата();
		МЗ.Записать();
		Списано = Списано + 1;

		ЧЗ_Журнал.Записать("Списание", Док1С, ДиадокDocumentId, Код,
			"Успех", "Причина " + КодПричины + ", ИНН покупателя " + ИННПокупателя);
	КонецЦикла;

	ЧЗ_Журнал.Записать("СписаниеИтог", Док1С, ДиадокDocumentId, "", "Успех",
		"Списано марок: " + Списано + ", пропущено: " + Пропущено);
КонецПроцедуры

// Код причины вывода из оборота «для собственных нужд» (ENTERPRISE_USE).
// В штатной функции ПричинаСписанияКодаМаркировки этой причины нет (факт из базы знаний, п.6),
// поэтому используем перечисление ПричиныВыводаИзОборота.ДляСобственныхНужд с защитой по имени.
Функция КодПричиныВыводаДляСобственныхНужд()
	КодПричины = "ENTERPRISE_USE";
	Попытка
		Если Перечисления[ПеречислениеПричиныВывода] <> Неопределено Тогда
			ЗначениеПер = Перечисления.ПричиныВыводаИзОборота.ДляСобственныхНужд;
			КодПричины = УправлениеКодамиМаркировкиКлиентСервер.ПричинаВыводаИзОборота(ЗначениеПер);
		КонецЕсли;
	Исключение
		// если штатный механизм недоступен — остаётся константа ENTERPRISE_USE
	КонецПопытки;
	Возврат КодПричины;
КонецФункции

// Определение контрагента-покупателя документа по именам-кандидатам реквизитов (оборонительный код, п.11).
Функция ЧЗ_КонтрагентДокумента(Док1С) Экспорт
	Имена = Новый Массив;
	Имена.Добавить("Контрагент");
	Имена.Добавить("Клиент");
	Имена.Добавить("Покупатель");
	Имена.Добавить("Заказчик");
	Для Каждого ИмяРекв Из Имена Цикл
		Попытка
			ЗначениеРекв = Док1С[ИмяРекв];
			Если ЗначениеЗаполнено(ЗначениеРекв) Тогда
				Возврат ЗначениеРекв;
			КонецЕсли;
		Исключение
			// реквизита с таким именем в этом документе нет — переходим к следующему кандидату
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
