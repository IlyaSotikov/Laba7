// ЧЗ: проверка кода маркировки (ядро требования 3 — ТСД/ДатаМобайл, локальная проверка в 1С).
// Значения Результат: ОК, ОшибкаФормата, Списан, НеИзДокумента, ДубльСкана, НеОтсканирован.

Функция ПроверитьКод(Код, ДокументОжидания = Неопределено) Экспорт
	Результат = Новый Структура("Код, Результат, Комментарий", Код, "ОК", "");

	Если НЕ ТипКодаМаркировкиДопустим(Код) Тогда
		Результат.Результат = "ОшибкаФормата";
		Результат.Комментарий = "Длина кода меньше 20 символов";
		Возврат Результат;
	КонецЕсли;

	МЗ = РегистрыСведений.ЧЗ_ОборотМарок.СоздатьМенеджерЗаписи();
	МЗ.КодМаркировки = Код;
	МЗ.Прочитать();
	Если МЗ.Статус = "Списан" Тогда
		Результат.Результат = "Списан";
		Результат.Комментарий = "Код уже списан документом " + Строка(МЗ.ДокументСписания);
		Возврат Результат;
	КонецЕсли;

	Если ДокументОжидания <> Неопределено Тогда
		Найден = Ложь;
		Попытка
			Для Каждого СтрокаТЧ Из ДокументОжидания.КодыМаркировки Цикл
				Если СтрокаТЧ.КодМаркировки = Код Тогда
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение
			// у документа нет ТЧ КодыМаркировки — не считаем кодом из документа
		КонецПопытки;
		Если НЕ Найден Тогда
			Результат.Результат = "НеИзДокумента";
			Результат.Комментарий = "Кода нет в ТЧ КодыМаркировки документа " + Строка(ДокументОжидания);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Проверка формата КМ: минимальная длина 20 символов (для DataMatrix шин — уточняется по дампу).
Функция ТипКодаМаркировкиДопустим(Код)
	Если ПустаяСтрока(Код) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрДлина(СокрЛП(Код)) >= 20;
КонецФункции

// Сверка массива сканов ТСД с ТЧ КодыМаркировки документа (требование 3, приёмка: ОК/ДубльСкана/НеИзДокумента/Списан/НеОтсканирован).
Функция СверитьСканыСДокументом(ДокументСсылка, МассивСканов) Экспорт
	Отчет = Новый ТаблицаЗначений;
	Отчет.Колонки.Добавить("Код");
	Отчет.Колонки.Добавить("Результат");
	Отчет.Колонки.Добавить("Комментарий");

	УжеВСписке = Новый Соответствие;
	Для Каждого Код Из МассивСканов Цикл
		Код = СокрЛП(Код);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Если УжеВСписке.Получить(Код) <> Неопределено Тогда
			Стр = Отчет.Добавить();
			Стр.Код = Код;
			Стр.Результат = "ДубльСкана";
			Стр.Комментарий = "Код отсканирован повторно в этой сессии";
			Продолжить;
		КонецЕсли;
		УжеВСписке.Вставить(Код, Истина);
		Проверка = ПроверитьКод(Код, ДокументСсылка);
		Стр = Отчет.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Проверка);
	КонецЦикла;

	// коды, которые есть в документе, но не отсканированы
	Попытка
		Для Каждого СтрокаТЧ Из ДокументСсылка.КодыМаркировки Цикл
			Если УжеВСписке.Получить(СтрокаТЧ.КодМаркировки) = Неопределено Тогда
				Стр = Отчет.Добавить();
				Стр.Код = СтрокаТЧ.КодМаркировки;
				Стр.Результат = "НеОтсканирован";
				Стр.Комментарий = "Код есть в документе, но отсутствует в сканах ТСД";
			КонецЕсли;
		КонецЦикла;
	Исключение
		// нет ТЧ — пропускаем обратную сверку
	КонецПопытки;

	Возврат Отчет;
КонецФункции
