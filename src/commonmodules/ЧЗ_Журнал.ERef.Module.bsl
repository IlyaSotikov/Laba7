// ЧЗ: журнал обмена с Диадок/ЧЗ. Все события ПМ и бизнес-операции пишутся сюда (требование 2, финал этапа 6).

Процедура Записать(Событие, Документ1С, ДиадокDocumentId, КодМаркировки, Результат, Комментарий) Экспорт
	МЗ = РегистрыСведений.ЧЗ_ЖурналОбмена.СоздатьМенеджерЗаписи();
	МЗ.ДатаВремя = ТекущаяДата();
	МЗ.Событие = Событие;
	МЗ.Документ1С = Документ1С;
	МЗ.ДиадокDocumentId = ДиадокDocumentId;
	МЗ.КодМаркировки = КодМаркировки;
	МЗ.Результат = Результат; // Успех / Предупреждение / Ошибка
	МЗ.Комментарий = Лев(Комментарий, 1000);
	Попытка
		МЗ.Пользователь = ИмяПользователя();
	Исключение
		МЗ.Пользователь = "";
	КонецПопытки;
	МЗ.Записать();
КонецПроцедуры
