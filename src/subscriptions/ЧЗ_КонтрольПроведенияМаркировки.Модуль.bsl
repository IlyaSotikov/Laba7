// ЧЗ: подписка на проведение документов — блокировка проведения без КМ (требования 4, 6).
// Виды документов Альфа-Авто: ПеремещениеТоваров / РеализацияТоваровУслуг / ЗаказНаряд —
// имена сверить с метаданными (п.11); подписка вешается через СписокВидовДокументовНиже.

Процедура ПередПроведением(Отказ, РежимПроведения) Экспорт
	Док = ПолучитьОбъектПодписки();
	Если Док = Неопределено Тогда Возврат; КонецЕсли;

	Если НЕ ТребуетсяМаркировкаПоВиду(Док) Тогда
		Возврат;
	КонецЕсли;

	Коды = МассивКМОбъекта(Док);
	Если Коды.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "ЧЗ: для проведения документа «" + Строка(Док)
			+ "" необходимо отсканировать коды маркировки (кнопка «ЧЗ: сканировать марки»).";
		Сообщение.Сообщить();
		// авто-открытие окна сканирования (требование 4) — сигнал форме
		ЗаписатьСобытиеФормы(Док);
		Возврат;
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьОбъектПодписки()
	// в реальном коде подписки объект передаётся параметром; здесь — универсальный доступ
	Возврат Неопределено; // заполняется генератором подписки по контексту события
КонецФункции

Функция ТребуетсяМаркировкаПоВиду(Док)
	ИмяВида = Метаданные.Документы[ИмяВидаДокумента(Док)].Имя;
	СписокТребующих = СтрРазделить("ПеремещениеТоваров,РеализацияТоваровУслуг,ЗаказНаряд,Перемещение,Реализация", ",", Ложь);
	Возврат СписокТребующих.Найти(ИмяВида) <> Неопределено;
КонецФункции

Функция ИмяВидаДокумента(Док)
	Ссылка = Док.Ссылка;
	Возврат СтрЗаменить(Строка(ТипЗнч(Ссылка)), "ДокументСсылка.", "");
КонецФункции

Функция МассивКМОбъекта(Док)
	Коды = Новый Массив;
	Попытка
		Для Каждого СтрокаТЧ Из Док.КодыМаркировки Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.КодМаркировки) Тогда
				Коды.Добавить(СтрокаТЧ.КодМаркировки);
			КонецЕсли;
		КонецЦикла;
	Исключение КонецПопытки;
	Возврат Коды;
КонецФункции

Процедура ЗаписатьСобытиеФормы(Док)
	// форма сама откроет окно сканирования по этому флагу журнала (см. расширение формы ЧЗ_СканМаркировки)
	ЧЗ_Журнал.Записать("БлокировкаПроведения", Док.Ссылка, "", "", "Предупреждение",
		"Проведение отклонено: нет КМ. Авто-открытие окна сканирования.");
КонецПроцедуры
