	// пусто
КонецПроцедуры

// Выполнить сверку: серверный вызов ЧЗ_ПроверкаКМ.СверитьСканыСДокументом.
Процедура СверитьНаСервере() Экспорт
	МассивСканов = Новый Массив;
	Строки = СтрРазделить(ТекстСканов, Символы.ПС, Ложь);
	Для Каждого СтрокаСкана Из Строки Цикл
		Сокращённый = СокрЛП(СтрокаСкана);
		Если НЕ ПустаяСтрока(Сокращённый) Тогда
			МассивСканов.Добавить(Сокращённый);
		КонецЕсли;
	КонецЦикла;

	ОтчетТЗ = ЧЗ_ПроверкаКМ.СверитьСканыСДокументом(Документ, МассивСканов);
	Отчет.Загрузить(ОтчетТЗ);

	ВсеОК = Истина;
	Для Каждого Стр Из Отчет Цикл
		Если Стр.Результат <> "ОК" Тогда
			ВсеОК = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЧЗ_Журнал.Записать("СверкаТСД", Документ, "", "",
		?(ВсеОК, "Успех", "Предупреждение"),
		"Сверка марок ТСД: строк отчета = " + Отчет.Количество());
КонецПроцедуры
