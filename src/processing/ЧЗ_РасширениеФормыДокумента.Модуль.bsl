// ЧЗ: расширение формы документов (Перемещение/Реализация/ЗаказНаряд) — авто-открытие окна
// сканирования при добавлении маркированной строки и кнопка «ЧЗ: сканировать марки» (требование 4).
// Клиентский модуль расширения формы.

Процедура ПриОткрытии(Отказ)
	ДобавитьКомандуПанели();
КонецПроцедуры

Процедура ДобавитьКомандуПанели()
	Команда = Элементы.Добавить("ЧЗ_СканироватьМарки", Тип("ФормаКоманда"), Элементы.ПанельКоманд);
	Команда.Заголовок = "ЧЗ: сканировать марки";
	Команда.Действие = "Новый Модуль.ЧЗ_ОткрытьОкноСканирования()";
КонецПроцедуры

// Авто-открытие: после добавления строки ТЧ с номенклатурой, требующей КМ (шина),
// открываем форму сканирования (встроенная ФормаСканированияМаркировки / наша ЧЗ_СканМаркировки).
Процедура ПослеЗаписи(ПослеЗаписиПараметры) Экспорт
	Если НЕ МаркированнаяНоменклатураВТЧ() Тогда Возврат; КонецЕсли;
	Если МассивКМВТЧ().Количество() = 0 Тогда
		ЧЗ_ОткрытьОкноСканирования();
	КонецЕсли;
КонецПроцедуры

Функция МаркированнаяНоменклатураВТЧ()
	// вид продукции tires (факт п.6: ВидПродуции() = "tires")
	Попытка
		Для Каждого СтрокаТЧ Из Объект.Материалы Цикл // или Товары — см. п.11
			Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
				Вид = СтрокаТЧ.Номенклатура.ВидПродукции; // кандидат
				Если Вид = "tires" Или (Вид <> Неопределено И Вид.Имя = "tires") Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение КонецПопытки;
	Попытка
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
				Возврат Истина; // консервативно: считаем маркированной, если не определили иначе
			КонецЕсли;
		КонецЦикла;
	Исключение КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция МассивКМВТЧ()
	Коды = Новый Массив;
	Попытка
		Для Каждого СтрокаТЧ Из Объект.КодыМаркировки Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ.КодМаркировки) Тогда Коды.Добавить(СтрокаТЧ.КодМаркировки); КонецЕсли;
		КонецЦикла;
	Исключение КонецПопытки;
	Возврат Коды;
КонецФункции

Процедура ЧЗ_ОткрытьОкноСканирования() Экспорт
	Параметры = Новый Структура("ДокументСсылка", Объект.Ссылка);
	// путь к форме обработки зависит от типа подключения (расширение/внешняя обработка) — кандидаты:
	Пути = СтрРазделить(
		"Расширение.ЧестныйЗнак_Расширение.Обработка.ЧЗ_СканМаркировки.Форма.ФормаСканирования,"
		+ "ВнешняяОбработка.ЧестныйЗнак_СканМаркировки.Форма.ФормаСканирования", ",", Ложь);
	Для Каждого Путь Из Пути Цикл
		Попытка
			ОткрытьФорму(Путь, Параметры);
			Возврат;
		Исключение
			// следующий кандидат
		КонецПопытки;
	КонецЦикла;
	Сообщить("ЧЗ: не найдена форма окна сканирования КМ.");
КонецПроцедуры
