// ЧЗ: отчёт «Паспорт кода маркировки» — история КМ union-ом регистров (этап 6).
// Вход: КодМаркировки (поле формы). Выход: ТЧ История(ДатаОперации, Источник, Событие, Документ1С, ДиадокDocumentId, Статус, Комментарий).

Процедура ПостроитьИсториюНаСервере(Код) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оборот.КодМаркировки КАК КодМаркировки,
	|	Оборот.ДатаОперации КАК ДатаОперации,
	|	""ЧЗ_ОборотМарок"" КАК Источник,
	|	""Текущий статус: "" + Оборот.Статус КАК Событие,
	|	Оборот.ДокументСписания КАК Документ1С,
	|	Оборот.ДиадокDocumentId КАК ДиадокDocumentId,
	|	Оборот.Статус КАК Статус,
	|	""Причина: "" + Оборот.ПричинаСписания + "", ИНН: "" + Оборот.ИННПокупателя КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЧЗ_ОборотМарок КАК Оборот
	|ГДЕ
	|	Оборот.КодМаркировки = &Код
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МаркиИзЭДО.КодМаркировки,
	|	МаркиИзЭДО.ДатаИзвлечения,
	|	""ЧЗ_МаркиИзЭДО"",
	|	""Извлечён из УПД (" + МаркиИзЭДО.Статус + "")"",
	|	МаркиИзЭДО.ДокументПоступление,
	|	МаркиИзЭДО.ДиадокDocumentId,
	|	МаркиИзЭДО.Статус,
	|	""Дата загрузки: "" + ?(МаркиИзЭДО.ДатаЗагрузки = ДАТАВРЕМЯ(1,1,1), ""—"", Формат(МаркиИзЭДО.ДатаЗагрузки, ""ДФ=dd.MM.yyyy HH:mm""))
	|ИЗ
	|	РегистрСведений.ЧЗ_МаркиИзЭДО КАК МаркиИзЭДО
	|ГДЕ
	|	МаркиИзЭДО.КодМаркировки = &Код
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Журнал.КодМаркировки,
	|	Журнал.ДатаВремя,
	|	""ЧЗ_ЖурналОбмена"",
	|	Журнал.Событие,
	|	Журнал.Документ1С,
	|	Журнал.ДиадокDocumentId,
	|	Журнал.Результат,
	|	Журнал.Комментарий
	|ИЗ
	|	РегистрСведений.ЧЗ_ЖурналОбмена КАК Журнал
	|ГДЕ
	|	Журнал.КодМаркировки = &Код";
	Запрос.УстановитьПараметр("Код", Код);
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Сортировать("ДатаОперации Убав");
	Возврат Результат;
КонецПроцедуры
