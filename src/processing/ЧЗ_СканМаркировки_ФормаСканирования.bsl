// ЧЗ: форма окна сканирования КМ (требование 4). Сканирование по Enter, проверка каждого кода
// через общий модуль ЧЗ_СканМаркировки.ДобавитьКодВПТЧДокумента, повторное открытие до полного покрытия.

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПолеВвода = "";
	Сосредоточить("ПолеВвода"); // ждём первый скан сразу
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаИзменение(НовоеЗначение)
	Если Прав(НовоеЗначение, 1) = Символы.ПС Тогда
		ОбработатьСкан(СокрЛП(Лев(НовоеЗначение, СтрДлина(НовоеЗначение)-1)));
		ПолеВвода = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСкан(Код)
	Рез = ДобавитьКодНаСервере(Код);
	Стр = Результаты.Добавить();
	Стр.Код = Код;
	Стр.Результат = Рез.Результат;
	Стр.Комментарий = Рез.Комментарий;
	ПроверкаЗаполненностиНаСервере();
КонецПроцедуры

&НаСервере
Функция ДобавитьКодНаСервере(Код)
	Возврат ЧЗ_СканМаркировки.ДобавитьКодВПТЧДокумента(ДокументСсылка, Код);
КонецФункции

&НаСервере
Процедура ПроверкаЗаполненностиНаСервере()
	// если все КМ из ожиданий внесены — закрываем форму с уведомлением
	Ожидаются = Новый Массив;
	Попытка
		Для Каждого СтрокаТЧ Из ДокументСсылка.КодыМаркировки Цикл
			Ожидаются.Добавить(СтрокаТЧ.КодМаркировки);
		КонецЦикла;
	Исключение КонецПопытки;
	Если Ожидаются.Количество() > 0 Тогда
		ВсеВнесены = Истина;
		Для Каждого КодОжидания Из Ожидаются Цикл
			Найден = Ложь;
			Для Каждого Стр Из Результаты Цикл
				Если Стр.Код = КодОжидания И Стр.Результат = "ОК" Тогда
					Найден = Истина; Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ Найден Тогда ВсеВнесены = Ложь; Прервать; КонецЕсли;
		КонецЦикла;
		Если ВсеВнесены Тогда
			Сообщить("ЧЗ: все ожидаемые КМ отсканированы.");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
