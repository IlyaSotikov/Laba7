// ЧЗ: РЗ «Контроль статусов ЭДО» — страховка/догон списаний (п.4.4). Каждые 15 минут.
// Если событие ПМ ПослеУстановкиСтатусаДокумента не отработало (сбой, перезапуск),
// находим исходящие УПД со статусом подписанности клиента без записей списания и догоняем.

Процедура ЧЗ_КонтрольСтатусовЭДО() Экспорт
	Попытка
		ОбработкаОбъект = Обработки.КонтурЭДО.Создать();
		ОбработкаОбъект.ВыполнитьКоманду("ЭДО_ВыполнитьРегламентныеДействия");
	Исключение
		ЧЗ_Журнал.Записать("КонтрольЭДО", Неопределено, "", "", "Предупреждение",
			"Не удалось запустить обмен Диадок: " + ОписаниеОшибки());
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Связи.Документ1С КАК Документ1С,
	|	Связи.ДиадокDocumentId КАК ДиадокDocumentId,
	|	Связи.СтатусПоследний КАК СтатусПоследний
	|ИЗ
	|	РегистрСведений.ЧЗ_СвязиДокументовЭДО КАК Связи
	|ГДЕ
	|	Связи.Направление = ""Outbound""
	|	И Связи.СтатусПоследний В (&СтатусыПодписан)
	|	И НЕ ВЫБРАТЬ
	|		1
	|	ИЗ
	|		РегистрСведений.ЧЗ_ОборотМарок КАК Оборот
	|	ГДЕ
	|		Оборот.ДокументСписания = Связи.Документ1С";

	Запрос.УстановитьПараметр("СтатусыПодписан", МассивИзСтроки("ПодписанКонтрагентом,ДокументооборотЗавершен"));

	Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
		Попытка
			ЧЗ_ОборотСервер.СписатьМаркиПоДокументу(Стр.Документ1С, Стр.ДиадокDocumentId);
			ЧЗ_Журнал.Записать("КонтрольЭДО", Стр.Документ1С, Стр.ДиадокDocumentId, "",
				"Успех", "Списание догнано регламентным заданием (статус: " + Стр.СтатусПоследний + ")");
		Исключение
			ЧЗ_Журнал.Записать("КонтрольЭДО", Стр.Документ1С, Стр.ДиадокDocumentId, "",
				"Ошибка", "Не удалось догнать списание: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция МассивИзСтроки(СтрокаСписком)
	Возврат СтрРазделить(СтрокаСписком, ",", Ложь);
КонецФункции
