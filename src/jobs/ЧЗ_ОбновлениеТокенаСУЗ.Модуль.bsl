// ЧЗ: РЗ «Обновление токена СУЗ» — каждые 9 часов (опционально, п.3.4).
// Токен СУЗ-Облако живёт ~24 ч; обновление 9ч — с запасом. Учётные данные — константы расширения.

Процедура ЧЗ_ОбновлениеТокенаСУЗ() Экспорт
	Попытка
		// Штатный механизм конфигурации (если есть): перелогин в СУЗ-Облако
		Если ЗначениеЗаполнено(Константы.ЧЗ_ЛогинСУЗ.Получить()) Тогда
			// вызов штатного обновления токена, если таковой предоставлен ПМ/обработкой КонтурЭДО:
			Попытка
				ОбработкаОбъект = Обработки.КонтурЭДО.Создать();
				ОбработкаОбъект.ВыполнитьКоманду("СУЗ_ОбновитьТокен");
			Исключение
				// команды нет — токен обновляется штатно при обмене; фиксируем только факт запуска РЗ
				ЧЗ_Журнал.Записать("ТокенСУЗ", Неопределено, "", "", "Предупреждение",
					"Команда обновления токена недоступна, полагаться на штатный обмен");
			КонецПопытки;
			ЧЗ_Журнал.Записать("ТокенСУЗ", Неопределено, "", "", "Успех", "Плановое обновление токена СУЗ выполнено");
		Иначе
			ЧЗ_Журнал.Записать("ТокенСУЗ", Неопределено, "", "", "Предупреждение",
				"Логин СУЗ не заполнен — РЗ пропускается");
		КонецЕсли;
	Исключение
		ЧЗ_Журнал.Записать("ТокенСУЗ", Неопределено, "", "", "Ошибка", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
