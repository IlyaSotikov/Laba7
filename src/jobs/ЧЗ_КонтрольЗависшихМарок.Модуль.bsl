// ЧЗ: РЗ «Контроль зависших марок» — ежедневно в 08:00 (п.4.6).
// 1) ЧЗ_МаркиИзЭДО со статусом «Извлечен» старше 3 рабочих дней без поступления → Предупреждение;
// 2) документы с ТЧ КодыМаркировки, не проведённые > 2 дней → Предупреждение;
// 3) ЧЗ_ОборотМарок «Списан» с пустым ДиадокDocumentId → Ошибка.

Процедура ЧЗ_КонтрольЗависшихМарок() Экспорт
	// 1) Извлеченные и незагруженные марки старше 3 рабочих дней
	Граница = НачалоДня(ТекущаяДата()) - 3*24*60*60; // упрощённо; точный расчёт рабочих дней — производственный календарь
	Запрос1 = Новый Запрос(
	"ВЫБРАТЬ
	|	Марки.КодМаркировки КАК КодМаркировки,
	|	МАКСИМУМ(Марки.ДатаИзвлечения) КАК ДатаИзвлечения
	|ИЗ
	|	РегистрСведений.ЧЗ_МаркиИзЭДО.СрезПоследних(&ГраницаОтбора, Статус = ""Извлечен"") КАК Марки
	|СГРУППИРОВАТЬ ПО
	|	Марки.КодМаркировки");
	Запрос1.УстановитьПараметр("ГраницаОтбора", Граница);
	Для Каждого Стр Из Запрос1.Выполнить().Выгрузить() Цикл
		Если Стр.ДатаИзвлечения < Граница Тогда
			ЧЗ_Журнал.Записать("ЗависшиеМарки", Неопределено, "", Стр.КодМаркировки, "Предупреждение",
				"Марка извлечена " + Формат(Стр.ДатаИзвлечения, "ДФ=dd.MM.yyyy") + " и не загружена в поступление > 3 раб. дней");
		КонецЕсли;
	КонецЦикла;

	// 2) Непроведённые документы с КМ старше 2 дней — проверяется по регистру связей/марок:
	//    если есть загруженные марки (статус Загружен) с ДокументПоступление, а документ не проведён.
	Запрос2 = Новый Запрос(
	"ВЫБРАТЬ
	|	Марки.ДокументПоступление КАК Документ,
	|	МАКСИМУМ(Марки.ДатаЗагрузки) КАК ДатаЗагрузки
	|ИЗ
	|	РегистрСведений.ЧЗ_МаркиИзЭДО.СрезПоследних(, ) КАК Марки
	|ГДЕ
	|	Марки.Статус = ""Загружен""
	|	И Марки.ДатаЗагрузки < &Граница2
	|СГРУППИРОВАТЬ ПО
	|	Марки.ДокументПоступление");
	Запрос2.УстановитьПараметр("Граница2", НачалоДня(ТекущаяДата()) - 2*24*60*60);
	Для Каждого Стр2 Из Запрос2.Выполнить().Выгрузить() Цикл
		Попытка
			Если НЕ Стр2.Документ.Проведен Тогда
				ЧЗ_Журнал.Записать("ЗависшиеМарки", Стр2.Документ, "", "", "Предупреждение",
					"Документ с загруженными КМ не проведён более 2 дней");
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЦикла;

	// 3) Списанные марки без DocumentId (не штатно) → Ошибка
	Запрос3 = Новый Запрос(
	"ВЫБРАТЬ
	|	Оборот.КодМаркировки КАК КодМаркировки
	|ИЗ
	|	РегистрСведений.ЧЗ_ОборотМарок.СрезПоследних(, Статус = ""Списан"") КАК Оборот
	|ГДЕ
	|	Оборот.ДиадокDocumentId = """"");
	Для Каждого Стр3 Из Запрос3.Выполнить().Выгрузить() Цикл
		ЧЗ_Журнал.Записать("ЗависшиеМарки", Неопределено, "", Стр3.КодМаркировки, "Ошибка",
			"Марка списана без ДиадокDocumentId — требуется ручная проверка");
	КонецЦикла;
КонецПроцедуры
